# 复制为 application-local.yml 并填写 volcengine.api-key（该文件已在 .gitignore）
volcengine:
  api-key: ${VOLCENGINE_API_KEY}

# 打开 Langfuse 时再设置，不要把 Authorization 提交到 git：
# LANGFUSE_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# LANGFUSE_OTLP_AUTHORIZATION=Basic <base64(publicKey:secretKey)>

agent:
  model: DeepSeek-V4.1-Flash
